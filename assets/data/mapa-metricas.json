    },
    "represented_parties_count": {
      "label": "Partidos representados",
      "unit": "count",
      "palette": "teal",
      "definition": "Número de listas eleitorais com pelo menos um deputado no círculo; cada coligação conta como uma única entidade."
    }
  },
